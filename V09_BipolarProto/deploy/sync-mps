#!/usr/bin/env bash
set -euo pipefail

# Keep SMEAR III monopolar data separate from the bipolar instrument on CSC.
source_dir="pi@mps:/home/pi/opetusSMPS/V09_BipolarProto/logs/"
destination_dir="/home/ubuntu/mps/logs/"
ssh_command="ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes -i /home/ubuntu/.ssh/raspberrypi_sync"

rsync_args=(-a --stats --timeout=120 --delay-updates --partial-dir=.rsync-partial)
case "${1:-}" in
    "") ;;
    --dry-run) rsync_args+=(--dry-run) ;;
    *) printf 'Usage: sync-mps [--dry-run]\n' >&2; exit 2 ;;
esac

# A Tailscale SSH check can otherwise hold a systemd job indefinitely.
timeout 30s ssh -o BatchMode=yes -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=yes -o IdentitiesOnly=yes \
    -i /home/ubuntu/.ssh/raspberrypi_sync \
    pi@mps test -d /home/pi/opetusSMPS/V09_BipolarProto/logs/scans

mkdir -p "${destination_dir}"
exec rsync "${rsync_args[@]}" -e "${ssh_command}" "${source_dir}" "${destination_dir}"
