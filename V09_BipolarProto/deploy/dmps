#!/usr/bin/env bash
set -euo pipefail
export PATH="${HOME}/.local/bin:${PATH}"

user_name="${USER}"
config="/etc/dmps/${user_name}.env"
if [[ ! -r "${config}" ]]; then
    printf 'Missing %s; run deploy/install-services.sh first.\n' "${config}" >&2
    exit 1
fi
# The root-owned installer config supplies APP_DIR and exact public origins.
source "${config}"

main_service="tdmps@${user_name}.service"
legacy_service="tdmps.service"

health_url() {
    printf 'http://127.0.0.1:%s/gui' "${DMPS_PANEL_PORT:-5006}"
}

check_health() {
    local url attempt main_pid server_ready=false
    url="$(health_url)"
    systemctl is-active --quiet "${main_service}"
    main_pid="$(systemctl show "${main_service}" -p MainPID --value)"
    if [[ ! "${main_pid}" =~ ^[1-9][0-9]*$ ]]; then
        printf 'main service has no active process\n' >&2
        return 1
    fi
    for attempt in {1..30}; do
        if curl --fail --silent --show-error --output /dev/null "${url}"; then
            server_ready=true
            break
        fi
        sleep 1
    done
    if [[ "${server_ready}" != true ]]; then
        printf 'main HTTP endpoint did not become ready: %s\n' "${url}" >&2
        return 1
    fi
    for attempt in {1..30}; do
        if "${APP_DIR}/.venv/bin/python" "${APP_DIR}/deploy/check-health.py" \
            "${DMPS_STATE_DIR:-${APP_DIR}}/health.json" 10 "${main_pid}"; then
            if systemctl is-active --quiet "${main_service}" \
                && [[ "$(systemctl show "${main_service}" -p MainPID --value)" == "${main_pid}" ]]; then
                printf 'main healthy: %s\n' "${url}"
                return 0
            fi
        fi
        sleep 1
    done
    printf 'main failed its health check: %s\n' "${url}" >&2
    return 1
}

control() {
    case "$1" in
        start|restart)
            if systemctl is-active --quiet "${legacy_service}"; then
                printf 'Refusing %s: legacy %s is active. Stop and disable it first.\n' \
                    "$1" "${legacy_service}" >&2
                return 1
            fi
            sudo systemctl "$1" "${main_service}"
            ;;
        stop) sudo systemctl stop "${main_service}" ;;
        status) systemctl --no-pager --full status "${main_service}" ;;
        health) check_health ;;
        log|logs) journalctl -u "${main_service}" -f ;;
        *) printf 'Unknown command: %s\n' "$1" >&2; exit 2 ;;
    esac
}

show_events() {
    local files
    shopt -s nullglob
    files=("${DMPS_STATE_DIR:-${APP_DIR}}"/logs/runtime/runtime-events-*.jsonl)
    if ((${#files[@]} == 0)); then
        printf 'No runtime event logs found.\n' >&2
        return 1
    fi
    tail -n 200 "${files[${#files[@]} - 1]}"
}

show_system_health() {
    local files
    shopt -s nullglob
    files=("${DMPS_STATE_DIR:-${APP_DIR}}"/logs/system/system-health-*.jsonl)
    if ((${#files[@]} == 0)); then
        printf 'No system health logs found.\n' >&2
        return 1
    fi
    tail -n 20 "${files[${#files[@]} - 1]}"
}

section() {
    printf '\n== %s ==\n' "$1"
}

diagnose_reboot() {
    section "Boot history"
    journalctl --list-boots --no-pager || true

    section "Current service state"
    systemctl --no-pager --full status "${main_service}" || true
    systemctl show "${main_service}" -p MainPID -p NRestarts -p ActiveState -p SubState || true

    section "Current Raspberry Pi power flags"
    if command -v vcgencmd >/dev/null 2>&1; then
        vcgencmd measure_temp || true
        vcgencmd get_throttled || true
    else
        printf 'vcgencmd not installed; cannot read Raspberry Pi throttling flags.\n'
    fi

    section "Hardware watchdog policy"
    busctl get-property org.freedesktop.systemd1 /org/freedesktop/systemd1 \
        org.freedesktop.systemd1.Manager RuntimeWatchdogUSec || true

    section "System health logger"
    systemctl --no-pager --full status "tdmps-health-log@${user_name}.service" || true
    show_system_health || true

    section "Tailscale state"
    tailscale version || true
    tailscale status || true

    section "Current boot kernel power/reset messages"
    journalctl -b -k --no-pager -n 200 \
        -g '([Uu]nder.?voltage|thermal|temperature|throttl|watchdog|reset|power|[Oo]ut of memory|oom-killer|Killed process|EXT4-fs|orphan)' || true

    section "Previous boot TDMPS service log"
    if journalctl -b -1 -n 1 --no-pager >/dev/null 2>&1; then
        journalctl -b -1 -u "${main_service}" --no-pager -n 200 || true
    else
        printf 'No previous boot journal found. Run dmps update or reinstall services to enable persistent journals.\n'
    fi

    section "Previous boot kernel power/reset messages"
    if journalctl -b -1 -n 1 --no-pager >/dev/null 2>&1; then
        journalctl -b -1 -k --no-pager -n 200 \
            -g '([Uu]nder.?voltage|thermal|temperature|throttl|watchdog|reset|power|[Oo]ut of memory|oom-killer|Killed process|EXT4-fs|orphan)' || true
    else
        printf 'No previous boot journal found.\n'
    fi
}

measurement_is_idle() {
    local main_pid
    if ! systemctl is-active --quiet "${main_service}"; then
        return 0
    fi
    main_pid="$(systemctl show "${main_service}" -p MainPID --value)"
    if [[ ! "${main_pid}" =~ ^[1-9][0-9]*$ ]]; then
        printf 'Could not verify measurement state: service has no active PID\n' >&2
        return 20
    fi
    "${APP_DIR}/.venv/bin/python" "${APP_DIR}/deploy/check-measurement-idle.py" \
        "${DMPS_STATE_DIR:-${APP_DIR}}/health.json" 10 "${main_pid}"
}

sync_runtime_files() {
    sudo install -d -o root -g root -m 0755 /etc/systemd/journald.conf.d
    sudo install -d -o root -g systemd-journal -m 2755 /var/log/journal
    sudo install -o root -g root -m 0755 "${APP_DIR}/deploy/check-port-available.py" /usr/local/libexec/dmps-port-available
    sudo install -o root -g root -m 0755 "${APP_DIR}/deploy/run-panel.sh" /usr/local/libexec/dmps-run-panel
    sudo install -o root -g root -m 0755 "${APP_DIR}/deploy/run-force-safe.sh" /usr/local/libexec/dmps-force-safe
    sudo install -o root -g root -m 0755 "${APP_DIR}/deploy/run-zero-bipolar.sh" /usr/local/libexec/dmps-zero-bipolar
    sudo install -o root -g root -m 0755 "${APP_DIR}/deploy/log-system-health.py" /usr/local/libexec/dmps-log-system-health
    sudo install -o root -g root -m 0644 "${APP_DIR}/deploy/tdmps@.service" /etc/systemd/system/tdmps@.service
    sudo install -o root -g root -m 0644 "${APP_DIR}/deploy/tdmps-serve@.service" /etc/systemd/system/tdmps-serve@.service
    sudo install -o root -g root -m 0644 "${APP_DIR}/deploy/tdmps-health-log@.service" /etc/systemd/system/tdmps-health-log@.service
    sudo install -o root -g root -m 0644 "${APP_DIR}/deploy/60-tdmps-persistent-journal.conf" /etc/systemd/journald.conf.d/60-tdmps-persistent-journal.conf
    install -m 0755 "${APP_DIR}/deploy/dmps" "${HOME}/bin/dmps"
    install -m 0644 "${APP_DIR}/deploy/dmps-completion.bash" "${HOME}/.dmps-complete"
    sudo systemctl daemon-reload
    sudo systemctl enable --now "tdmps-health-log@${user_name}.service"
    sudo systemctl restart systemd-journald
    sudo journalctl --flush
    if ! systemctl is-active --quiet tdmps.service; then
        sudo systemctl disable tdmps.service tdmps-serve.service >/dev/null 2>&1 || true
    fi
}

update_app() {
    local repo_root main_was_active=false lock_file
    repo_root="$(git -C "${APP_DIR}" rev-parse --show-toplevel)"
    lock_file="${DMPS_STATE_DIR:-${APP_DIR}}/maintenance.lock"
    exec 9>"${lock_file}"
    if ! flock --nonblock --exclusive 9; then
        printf 'Refusing update: a measurement or another update is active.\n' >&2
        return 1
    fi
    if systemctl is-active --quiet "${legacy_service}"; then
        printf 'Refusing update: legacy %s is active. Stop and disable it first.\n' \
            "${legacy_service}" >&2
        return 1
    fi
    if [[ -n "$(git -C "${repo_root}" status --porcelain --untracked-files=normal)" ]]; then
        printf 'Refusing update: repository has tracked or untracked changes.\n' >&2
        git -C "${repo_root}" status --short >&2
        return 1
    fi
    if ! measurement_is_idle; then
        printf 'Refusing update: measurement is active or its state could not be verified.\n' >&2
        return 1
    fi
    systemctl is-active --quiet "${main_service}" && main_was_active=true

    git -C "${repo_root}" fetch --prune origin
    if ! measurement_is_idle; then
        printf 'Refusing update after fetch: measurement is active or its state could not be verified.\n' >&2
        return 1
    fi
    if [[ "${main_was_active}" == true ]]; then
        sudo systemctl stop "${main_service}"
    fi
    git -C "${repo_root}" pull --ff-only
    cd "${APP_DIR}"
    uv sync --locked
    uv pip install --python "${APP_DIR}/.venv/bin/python" -r requirements-hardware.txt
    "${APP_DIR}/.venv/bin/python" deploy/compile-check.py gui.py gui_app.py gui_runtime_host.py DmpsControl deploy/force-safe.py deploy/zero-bipolar.py deploy/check-health.py deploy/check-measurement-idle.py deploy/check-port-available.py
    sync_runtime_files

    if [[ "${main_was_active}" == true ]]; then
        sudo systemctl start "${main_service}"
        check_health
    fi
    printf 'Update complete. Services that were stopped remain stopped.\n'
}

case "${1:-help}" in
    start|stop|restart|status|health|log|logs) control "$1" ;;
    diagnose-reboot) diagnose_reboot ;;
    event|events) show_events ;;
    system-health|temperature|temp) show_system_health ;;
    update) update_app ;;
    process|ps) systemctl show "${main_service}" -p MainPID -p NRestarts -p ActiveState -p SubState ;;
    url) printf 'Main: https://%s/gui\n' "${DMPS_WEBSOCKET_ORIGIN_MAIN}" ;;
    shell) cd "${APP_DIR}"; exec "${SHELL:-/bin/bash}" ;;
    help|-help|--help|-h)
        cat <<'EOF'
Usage:
  dmps start|stop|restart|status|health|log|events
  dmps update       Fast-forward a clean, idle checkout and safely restart
  dmps process      Show the main service process state
  dmps events       Show the latest persistent runtime events
  dmps system-health  Show recent temperature, power, load, and network records
  dmps diagnose-reboot  Print retained logs useful after power loss or reset
  dmps url          Print configured Tailscale URLs
  dmps shell        Open a shell in V09_BipolarProto
EOF
        ;;
    *) printf "Unknown command. Run 'dmps help'.\n" >&2; exit 2 ;;
esac
