[Unit]
Description=TDMPS hardware GUI
After=network-online.target tdmps.service
Wants=network-online.target
Conflicts=tdmps.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=%i
Environment=DMPS_PANEL_PORT=5006
EnvironmentFile=/etc/dmps/%i.env
ExecCondition=/usr/local/libexec/dmps-port-available 127.0.0.1 ${DMPS_PANEL_PORT}
ExecStartPre=/usr/local/libexec/dmps-zero-bipolar
ExecStart=/usr/bin/env /usr/local/libexec/dmps-run-panel main
ExecStopPost=/usr/local/libexec/dmps-force-safe
Restart=on-failure
RestartSec=5
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=256M
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
