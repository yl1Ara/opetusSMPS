[Unit]
Description=Tailscale Serve for TDMPS hardware GUI
After=tailscaled.service tdmps-serve.service tdmps@%i.service
Wants=tailscaled.service
Conflicts=tdmps-serve.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DMPS_PANEL_PORT=5006
EnvironmentFile=/etc/dmps/%i.env
ExecStart=/usr/bin/tailscale serve --bg --https=443 http://127.0.0.1:${DMPS_PANEL_PORT}
ExecStop=/usr/bin/tailscale serve --https=443 off

[Install]
WantedBy=multi-user.target
